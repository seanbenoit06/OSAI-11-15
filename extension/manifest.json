{
  "manifest_version": 3,
  "name": "Lease Red-Flag Checker",
  "version": "1.0",
  "description": "Highlights risky or unusual clauses in leases/contracts.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "match_about_blank": true,
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/pdfjs/pdf.worker.mjs"],
      "matches": ["<all_urls>"]
    }
  ]
}
